---
// @ts-ignore
import { Icon } from "astro-icon/components";

const icons = {
  amazonaws: "Amazon Web Services",
  astro: "Astro",
  docker: "Docker",
  express: "Express",
  github: "GitHub",
  googlecloud: "Google Cloud Platform",
  jest: "Jest",
  less: "Less",
  mailgun: "Mailgun",
  nodedotjs: "Node.js",
  npm: "NPM",
  openai: "OpenAI API",
  php: "PHP",
  pnpm: "PNPM",
  preact: "Preact",
  puppeteer: "Puppeteer",
  python: "Python",
  react: "React",
  reactquery: "TanStack Query",
  reactrouter: "React Router",
  render: "Render.com",
  sass: "Sass",
  shopify: "Shopify custom themes",
  svelte: "Svelte",
  tailwindcss: "Tailwind CSS",
  typescript: "TypeScript",
  vercel: "Vercel",
  vite: "Vite",
  vitest: "Vitest",
  gatsby: "Gatsby",
  netlify: "Netlify",
  cloudflare: "Cloudflare",
  wordpress: "WordPress custom themes & plugins",
  ruby: "Ruy",
  eslint: "ESLint",
  prettier: "Prettier",
  rubyonrails: "Ruby on Rails",
  circleci: "CircleCI",
  esbuild: "esbuild",
  git: "Git",
  githubactions: "GitHub Actions",
  googleanalytics: "Google Analytics",
  jekyll: "Jekyll",
  jquery: "jQuery",
  slack: "Slack custom bots",
  telegram: "Telegram custom bots",
  awslambda: "AWS Lambda",
  electron: "Electron",
  flask: "Flask",
  airtable: "Airtable",
  amazoncloudwatch: "Amazon CloudWatch",
  amazonec2: "Amazon EC2",
  amazonecs: "Amazon ECS",
  amazonrds: "Amazon RDS",
  amazons3: "Amazon S3",
  wasabi: "Wasabi",
};
---

<div class="mt-24 lg:mt-32">
  <p class="text-center text-frost-dark font-mono text-xs uppercase tracking-widest">
    Technologies we've used in previous projects
  </p>
  <div
    class="flex gap-7 items-center justify-center mt-10 flex-wrap text-frost-dark/60">
    {
      Object.keys(icons)
        .sort((a, b) => a.localeCompare(b))
        .map((k) => (
          <Icon
            class="size-7 hover:text-frost transition-colors duration-200"
            name={`simple-icons:${k}`}
            title={icons[k]}
          />
        ))
    }
  </div>
</div>
