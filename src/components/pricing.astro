---
import { Tick } from "@components/ui/icons";
import Link from "@components/ui/link.astro";

const { plan } = Astro.props;
---

<div>
  <div
    class="flex flex-col w-full order-first lg:order-none border border-white/[0.08] bg-navy-700/30 py-5 px-6 rounded-lg">
    <div class="text-center">
      <h4 class="text-lg font-medium text-frost">{plan.name}</h4>
      <p class="mt-3 text-4xl font-bold text-white md:text-4xl">
        {
          plan.price && typeof plan.price === "object"
            ? plan.price.monthly
            : plan.price
        }
      </p>
    </div>
    <ul class="grid mt-8 text-left gap-y-4">
      {
        plan.features.map((item) => (
          <li class="flex items-start gap-3 text-frost">
            <Tick class="w-6 h-6 text-sage" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
    <div class="flex mt-8">
      <Link
        href={plan.button.link || "#"}
        block
        style={plan.popular ? "primary" : "outline"}>
        {plan.button.text || "Get Started"}
      </Link>
    </div>
  </div>
</div>
