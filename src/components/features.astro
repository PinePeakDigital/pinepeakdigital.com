---
import data from "../process.yaml";
import Link from "./ui/link.astro";
---

<div class="mt-24 lg:mt-32">
  <h2 class="font-display text-3xl lg:text-4xl text-white">
    Understand our process
  </h2>
  <p class="text-lg mt-4 text-frost max-w-2xl">
    We follow a proven process to ensure that your project is delivered on time
    and on budget. Our process helps you define your needs, identify potential
    risks, and execute with precision.
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-12 gap-6 lg:gap-8">
  {
    data.steps.slice(0, 3).map((item, i) => (
      <div class="group bg-navy-700/30 border border-white/[0.06] rounded-lg p-6 lg:p-8 transition-colors hover:border-white/[0.1]">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 rounded-full bg-sage/15 text-sage flex items-center justify-center text-sm font-semibold">
            {i + 1}
          </div>
          <h3 class="font-semibold text-white">{item.name}</h3>
        </div>
        <p class="text-frost text-sm leading-relaxed">{item.description}</p>
      </div>
    ))
  }
</div>

<div class="mt-8 flex flex-col sm:flex-row gap-3">
  <Link href="/contact" size="md">Start Now</Link>
  <Link href="/process" size="md" style="outline">Learn More</Link>
</div>
