---
const { align = "center" } = Astro.props;
---

<div class:list={["mt-32 pt-4", align === "center" && "text-center"]}>
  <h1 class="font-display text-4xl lg:text-5xl text-white tracking-tight">
    <slot name="title">Title</slot>
  </h1>
  <p class="text-lg mt-4 text-frost">
    <slot name="desc">Some description goes here</slot>
  </p>
</div>
