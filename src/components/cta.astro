---
import Link from "./ui/link.astro";
---

<div
  class="relative bg-navy-700/50 border border-white/[0.06] p-10 md:px-20 md:py-16 mt-24 lg:mt-32 mx-auto max-w-5xl rounded-lg flex flex-col items-center text-center overflow-hidden">
  <!-- Subtle glow -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[400px] h-[200px] bg-sage/5 rounded-full blur-[100px] pointer-events-none"
  ></div>

  <h2 class="font-display text-3xl md:text-5xl text-white relative z-10">
    Let's make something great.
  </h2>
  <p class="text-frost mt-4 text-lg relative z-10">
    Click the button below to reach out and start a conversation.
  </p>
  <div class="flex mt-8 relative z-10">
    <Link href="/contact">Get Started</Link>
  </div>
</div>
