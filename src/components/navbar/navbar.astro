---
import Container from "@components/container.astro";
import Link from "@components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

type MenuItem =
  | {
      title: string;
      path: string;
      badge?: boolean;
      children?: never;
    }
  | {
      title: string;
      children: { title: string; path: string }[];
      badge?: boolean;
      path?: never;
    };

const menuitems: MenuItem[] = [
  {
    title: "Home",
    path: "/",
  },
  {
    title: "Services",
    children: [
      { title: "Software Development", path: "/services/software-development" },
      { title: "AI Automation", path: "/services/ai-automation" },
    ],
  },
  {
    title: "About",
    path: "/about",
  },
  {
    title: "Contact",
    path: "/contact",
  },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 border-b border-white/[0.06] bg-midnight/80 backdrop-blur-xl">
  <Container>
    <nav class="flex flex-col lg:flex-row justify-between items-center py-4">
      <Astronav>
        <div class="flex w-full lg:w-auto items-center justify-between">
          <a href="/" class="flex items-center group">
            <span class="font-display text-lg text-white">Pine Peak Digital</span>
          </a>
          <div class="block lg:hidden">
            <MenuIcon class="w-5 h-5 text-frost" />
          </div>
        </div>
        <MenuItems
          class="hidden w-full lg:w-auto mt-4 lg:flex lg:mt-0 border-t border-white/[0.06] lg:border-0 pt-4 lg:pt-0">
          <ul class="flex flex-col lg:flex-row lg:gap-1">
            {
              menuitems.map((item, index) => (
                <>
                  {item.children && (
                    <Dropdown
                      title={item.title}
                      children={item.children}
                      lastItem={index === menuitems.length - 1}
                    />
                  )}

                  {!item.children && (
                    <li>
                      <a
                        href={item.path}
                        class="flex lg:px-4 py-2 items-center font-mono text-sm text-frost hover:text-white transition-colors duration-200">
                        <span>{item.title}</span>
                        {item.badge && (
                          <span class="ml-2 px-2 py-0.5 text-[10px] font-semibold uppercase text-white bg-sage rounded-full">
                            New
                          </span>
                        )}
                      </a>
                    </li>
                  )}
                </>
              ))
            }
          </ul>
          <div class="lg:hidden flex items-center mt-4 gap-4 pb-2">
            <Link href="/contact" size="md" block>Get Started</Link>
          </div>
        </MenuItems>
      </Astronav>
      <div>
        <div class="hidden lg:flex items-center gap-4">
          <Link href="/contact" size="md">Get Started</Link>
        </div>
      </div>
    </nav>
  </Container>
</header>
