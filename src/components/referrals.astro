---
const referrals: {
  title: string;
  description: string;
}[] = [
  {
    title: "Matthew Leffler",
    description:
      "I've worked with few people able to bring the level of exactness and rigor that Nathan brings to his work. Nathan and I have worked together in a variety of roles over the last 10 years. He is process-driven, relentlessly refining and curating for greater efficiency and higher-quality outcomes. I've always appreciated his care for his craft and the continual learning and insights he brings to a team.",
  },
  {
    title: "Alistair Huong",
    description:
      "I've had the opportunity to work with Nathan in different capacities for over 10 years, and specifically in his role as a software developer in the context of AudioVerse. He is meticulous, thoughtful, and easy to work with. He possesses a natural conscientiousness about the details, is forward-thinking about potential risks, and blends it all with a good sense of aesthetics. I've appreciated his can-do attitude, even with new technologies, and his willingness to collaborate with all stakeholders. His excellent communication skills are a real asset to complement his technical capabilities.",
  },
  {
    title: "Daniel Reeves",
    description:
      "Working with Nathan and Pine Peak Digital is a delight. He's fair-minded and diligent and thoughtful. You can see his handiwork especially in the design of the Beeminder blog, with much more behind the scenes. Highly recommended.",
  },
];
---

<div class="mt-24 lg:mt-32">
  <div class="flex items-center gap-3 mb-6">
    <span class="font-mono text-sage-light text-xs uppercase tracking-[0.15em]"
      >> Testimonials</span
    >
    <div class="h-px w-10 bg-sage-light/60"></div>
  </div>
  <h2 class="font-display text-3xl lg:text-4xl text-white">
    What people are saying
  </h2>
</div>

<div class="grid md:grid-cols-3 mt-12 gap-6 lg:gap-8">
  {
    referrals.map((item, i) => (
      <div class="bg-navy-700/30 border border-white/[0.06] rounded-lg p-6 lg:p-8 font-mono hover:border-sage/20 transition-colors">
        <p class="text-sage-light/40 text-xs mb-4">{`> log[${String(i).padStart(2, "0")}]`}</p>
        <p class="text-frost text-sm leading-relaxed font-sans">
          "{item.description}"
        </p>
        <p class="text-frost-dark text-xs mt-5">
          <span class="text-sage-light/50">//</span> {item.title}
        </p>
      </div>
    ))
  }
</div>
