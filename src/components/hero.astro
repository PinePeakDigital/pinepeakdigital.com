---
import Link from "@components/ui/link.astro";
import Container from "@components/container.astro";
---

<section
  class="relative bg-gradient-to-b from-navy-800 via-navy-900 to-midnight pt-36 pb-24 md:pt-44 md:pb-32 lg:pt-52 lg:pb-36 overflow-hidden">
  <!-- Film grain texture -->
  <div
    class="film-grain absolute inset-0 opacity-[0.035] pointer-events-none mix-blend-overlay"
    aria-hidden="true"
  ></div>

  <!-- Topographic contour map — full background -->
  <div
    class="topo-bg absolute inset-0 pointer-events-none opacity-[0.07]"
    aria-hidden="true"
  ></div>

  <!-- Animated atmospheric glows -->
  <div
    class="hero-glow-1 absolute top-20 left-[15%] w-[500px] h-[400px] bg-navy-600 rounded-full blur-[80px] md:blur-[160px] opacity-30 pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    class="hero-glow-2 absolute top-40 right-[10%] w-[300px] h-[300px] bg-navy-500 rounded-full blur-[60px] md:blur-[120px] opacity-20 pointer-events-none"
    aria-hidden="true"
  ></div>

  <Container class="relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <!-- Typographic accent -->
        <div class="flex items-center gap-3 mb-8">
          <span
            class="font-mono text-sage-light text-xs uppercase tracking-[0.15em]"
            >> Web Development Agency</span
          >
          <div class="h-px w-10 bg-sage-light/60"></div>
        </div>

        <h1
          class="font-display text-5xl md:text-6xl lg:text-7xl xl:text-[5.5rem] text-white leading-[1.05] tracking-tight">
          Building the<br />Modern Web
        </h1>
        <p
          class="mt-8 text-lg md:text-xl text-frost leading-relaxed max-w-2xl">
          Our agency specializes in modern full-stack web applications using the
          latest technologies. We build websites, web applications, server
          backends, and mobile apps that are fast, secure, and scalable.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4">
          <Link href="/contact">Contact Us</Link>
          <Link href="/about" style="outline">About Us</Link>
        </div>
      </div>

      <div class="hidden lg:block">
        <img
          src="/computer.svg"
          alt="Illustration of a computer workstation"
          class="w-full max-w-lg mx-auto"
        />
      </div>
    </div>
  </Container>

</section>

<style>
  .film-grain {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }
  .topo-bg {
    background-image: url("/topo.svg");
    background-size: 500px 500px;
    background-repeat: repeat;
  }
  @keyframes glow-drift {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(18px, -12px);
    }
  }
  @keyframes glow-drift-alt {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(-12px, 16px);
    }
  }
  .hero-glow-1 {
    animation: glow-drift 14s ease-in-out infinite;
  }
  .hero-glow-2 {
    animation: glow-drift-alt 18s ease-in-out infinite;
  }
</style>
