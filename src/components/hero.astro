---
import Link from "@components/ui/link.astro";
import Container from "@components/container.astro";
---

<section
  class="relative bg-gradient-to-b from-navy-800 via-navy-900 to-midnight pt-36 pb-48 md:pt-44 md:pb-56 lg:pt-52 lg:pb-64 overflow-hidden">
  <!-- Subtle atmospheric glow -->
  <div
    class="absolute top-20 left-[15%] w-[500px] h-[400px] bg-navy-600 rounded-full blur-[160px] opacity-30 pointer-events-none"
  ></div>
  <div
    class="absolute top-40 right-[10%] w-[300px] h-[300px] bg-navy-500 rounded-full blur-[120px] opacity-20 pointer-events-none"
  ></div>

  <Container class="relative z-10">
    <div class="max-w-3xl">
      <h1
        class="font-display text-5xl md:text-6xl lg:text-7xl xl:text-[5.5rem] text-white leading-[1.05] tracking-tight">
        Building the<br />Modern Web
      </h1>
      <p class="mt-8 text-lg md:text-xl text-frost leading-relaxed max-w-2xl">
        Our agency specializes in modern full-stack web applications using the
        latest technologies. We build websites, web applications, server
        backends, and mobile apps that are fast, secure, and scalable.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <Link href="/contact">Contact Us</Link>
        <Link href="/about" style="outline">About Us</Link>
      </div>
    </div>
  </Container>

  <!-- Mountain ridgeline decoration -->
  <div class="absolute bottom-0 left-0 right-0 pointer-events-none">
    <svg
      class="w-full h-20 md:h-28 lg:h-36"
      viewBox="0 0 1440 160"
      preserveAspectRatio="none"
      fill="none"
      xmlns="http://www.w3.org/2000/svg">
      <!-- Distant ridge -->
      <path
        d="M0,160 V95 C90,80 150,58 240,65 C330,72 400,48 480,40 C560,32 640,52 720,56 C800,60 880,36 960,30 C1040,24 1120,46 1200,50 C1280,54 1360,40 1440,62 V160Z"
        class="fill-midnight"
        opacity="0.45"></path>
      <!-- Near ridge -->
      <path
        d="M0,160 V115 C70,100 130,76 200,80 C270,84 340,52 420,45 C500,38 580,58 660,64 C740,70 820,32 900,26 C980,20 1060,48 1140,52 C1220,56 1300,38 1440,50 V160Z"
        class="fill-midnight"></path>
    </svg>
  </div>
</section>
