---
interface Props {
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted";
  class?: string;
  [x: string]: any;
}

const {
  size = "md",
  style = "primary",
  block,
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  md: "px-5 py-2.5",
  lg: "px-6 py-3",
};

const styles = {
  outline:
    "border border-white/20 hover:border-white/40 hover:bg-white/[0.04] text-white",
  primary:
    "bg-sage text-white hover:bg-sage-light border border-sage hover:border-sage-light",
  inverted:
    "bg-white text-midnight hover:bg-frost-light border border-transparent",
};
---

<button
  {...rest}
  class:list={[
    "rounded text-center font-mono text-sm tracking-wide transition-all duration-200 focus-visible:ring-2 ring-offset-2 ring-offset-midnight ring-sage/50",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</button>
