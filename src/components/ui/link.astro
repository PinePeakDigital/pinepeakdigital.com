---
interface Props {
  href: string;
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted" | "muted";
  class?: string;
  [x: string]: any;
}

const {
  href,
  block,
  size = "lg",
  style = "primary",
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  lg: "px-6 py-2.5",
  md: "px-5 py-2",
};

const styles = {
  primary:
    "bg-sage text-white hover:bg-sage-light border border-sage hover:border-sage-light",
  outline:
    "bg-transparent text-white border border-white/20 hover:border-white/40 hover:bg-white/[0.04]",
  inverted:
    "bg-white text-midnight hover:bg-frost-light border border-transparent",
  muted:
    "bg-navy-600 text-frost hover:bg-navy-500 border border-transparent",
};
---

<a
  href={href}
  {...rest}
  class:list={[
    "rounded text-center text-sm font-medium tracking-wide transition-all duration-200 focus-visible:ring-2 ring-offset-2 ring-offset-midnight ring-sage/50",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</a>
