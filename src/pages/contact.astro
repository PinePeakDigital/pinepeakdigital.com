---
import Contactform from "@components/contactform.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Contact">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Contact</Fragment>
      <Fragment slot="desc">What do you want to build?</Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-16">
      <div>
        <h2 class="font-display text-2xl text-white">Send us a message</h2>
        <p class="text-base leading-relaxed text-frost mt-4">
          Let's start building something great. Send us a message and we will
          get back to you as soon as possible.
        </p>
        <div class="mt-6">
          <div class="flex items-center space-x-3 text-frost">
            <Icon class="text-frost-dark w-4 h-4" name="uil:envelope" /><a
              href="mailto:nathan@pinepeakdigital.com"
              class="hover:text-white transition-colors"
              >nathan@pinepeakdigital.com</a
            >
          </div>
        </div>
      </div>
      <div>
        <Contactform />
      </div>
    </div>
  </Container>
</Layout>
