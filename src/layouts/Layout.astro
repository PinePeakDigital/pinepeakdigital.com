---
import { SEO } from "astro-seo";
import Footer from "@components/footer.astro";
import Navbar from "@components/navbar/navbar.astro";
import "@fontsource/dm-serif-display";
import "@fontsource/dm-mono";
import "@fontsource-variable/outfit";

export interface Props {
  title: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const resolvedImageWithDomain = new URL(
  "/opengraph.jpg",
  Astro.site,
).toString();

const { title } = Astro.props;

const makeTitle = title
  ? title + " | " + "Pine Peak Digital"
  : "Pine Peak Digital - Building the Modern Web";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="https://fav.farm/⛰️" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={makeTitle}
      description="Pine Peak Digital is a web development agency specializing in modern full-stack applications. We build fast, secure, and scalable websites, web apps, and backends."
      canonical={canonicalURL}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: `Pine Peak Digital - Building the Modern Web`,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: "Pine Peak Digital Homepage",
        },
      }}
    />
  </head>
  <body class="bg-midnight text-white antialiased">
    <Navbar />
    <slot />
    <Footer />
    <style is:global>
      img {
        content-visibility: auto;
      }

      ::selection {
        background-color: rgba(107, 158, 116, 0.3);
        color: white;
      }

      /* Prose overrides for dark mode */
      .prose {
        --tw-prose-body: #8ea4c4;
        --tw-prose-headings: #ffffff;
        --tw-prose-lead: #b4c5dc;
        --tw-prose-links: #83b68b;
        --tw-prose-bold: #ffffff;
        --tw-prose-counters: #5a7399;
        --tw-prose-bullets: #5a7399;
        --tw-prose-hr: #1e3050;
        --tw-prose-quotes: #b4c5dc;
        --tw-prose-quote-borders: #1e3050;
        --tw-prose-captions: #5a7399;
        --tw-prose-code: #ffffff;
        --tw-prose-pre-code: #b4c5dc;
        --tw-prose-pre-bg: #111d35;
        --tw-prose-th-borders: #1e3050;
        --tw-prose-td-borders: #162544;
      }
    </style>
  </body>
</html>
